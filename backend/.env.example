# Sao chép thành .env rồi sửa. Mọi giá trị đều có mặc định để chạy demo.

# PostgreSQL (bắt buộc CSDL quan hệ để dùng transaction + SELECT ... FOR UPDATE)
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/medcare
JWT_SECRET=EmBNGbpHafBcoQUUyFrYTQUvlpgivG
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# F1 – LLM. auto: có key nào dùng key đó; không có key thì dùng bộ phân loại offline
LLM_PROVIDER=auto
OPENAI_API_KEY=   # đã có sẵn, giữ nguyên nếu đúng key
OPENAI_BASE_URL=    # thêm mới
OPENAI_MODEL=qwen3.5-9b             # sửa lại nếu đang là gpt-4o-mini


# F2 – SePay webhook: header "Authorization: Apikey <SEPAY_API_KEY>"
SEPAY_API_KEY=
# true: hiện nút "Giả lập ngân hàng báo tiền về" và mở /api/payments/dev/simulate
PAYMENT_DEV_MODE=true

# Cloudinary (để trống thì lưu vào thư mục uploads/)
CLOUDINARY_URL=

# SMTP (để trống thì email được ghi ra thư mục outbox/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MedCare <no-reply@medcare.local>
