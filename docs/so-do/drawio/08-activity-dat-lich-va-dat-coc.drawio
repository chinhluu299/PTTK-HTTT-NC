<mxfile host="app.diagrams.net" agent="MedCare diagram generator" version="24.7.0"><diagram id="d1" name="Activity – F2: Đặt lịch giữ chỗ và đặt cọc VietQR"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1838.4" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="zz2" value="Activity – F2: Đặt lịch giữ chỗ và đặt cọc VietQR" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#0f172a;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="578.8" height="30" as="geometry"/></mxCell><mxCell id="zz3" value="Tham chiếu: backend/app/booking.py (create_hold, process_bank_transfer), routers/appointments.py, payments.py, jobs.py" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748b;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="694.96" height="20" as="geometry"/></mxCell><mxCell id="zz4" value="Bệnh nhân" style="swimlane;html=1;startSize=34;collapsible=0;container=0;fontSize=13;fontStyle=1;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="300" height="1716.4" as="geometry"/></mxCell><mxCell id="zz5" value="Hệ thống" style="swimlane;html=1;startSize=34;collapsible=0;container=0;fontSize=13;fontStyle=1;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="330" y="72" width="320" height="1716.4" as="geometry"/></mxCell><mxCell id="zz6" value="Ngân hàng / SePay" style="swimlane;html=1;startSize=34;collapsible=0;container=0;fontSize=13;fontStyle=1;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="650" y="72" width="270" height="1716.4" as="geometry"/></mxCell><mxCell id="zz7" value="Job nền (mỗi phút)" style="swimlane;html=1;startSize=34;collapsible=0;container=0;fontSize=13;fontStyle=1;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="920" y="72" width="260" height="1716.4" as="geometry"/></mxCell><mxCell id="s" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="167" y="123" width="26" height="26" as="geometry"/></mxCell><mxCell id="pick" value="Nhận chuyên khoa từ gợi ý AI&lt;br&gt;(hoặc bấm «Khám tổng quát»&lt;br&gt;→ Nội tổng quát, bỏ qua AI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="55" y="204" width="250" height="72" as="geometry"/></mxCell><mxCell id="sug" value="Đề xuất khung giờ sớm nhất còn chỗ:&lt;br&gt;bỏ khung bác sĩ nghỉ, khung đủ 3 người;&lt;br&gt;chọn bác sĩ ít lịch nhất trong ngày" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="350" y="308" width="280" height="72" as="geometry"/></mxCell><mxCell id="agree" value="Đồng ý đề xuất hoặc&lt;br&gt;chọn ngày, giờ khác" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="65" y="420" width="230" height="56" as="geometry"/></mxCell><mxCell id="login" value="Đăng nhập hoặc đăng ký nhanh&lt;br&gt;(SĐT, mật khẩu, họ tên, năm sinh,&lt;br&gt;giới tính); gắn phiên chat với AI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="55" y="516" width="250" height="72" as="geometry"/></mxCell><mxCell id="chk" value="Kiểm tra: Thứ 2–7, chưa qua giờ,&lt;br&gt;trong 2 tuần; phiên AI hợp lệ và đã&lt;br&gt;xác nhận cảnh báo cấp cứu (nếu có)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="350" y="620" width="280" height="72" as="geometry"/></mxCell><mxCell id="lock" value="Khóa dòng bác sĩ&lt;br&gt;(SELECT … FOR UPDATE),&lt;br&gt;đếm chỗ trong khung" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="375" y="724" width="230" height="72" as="geometry"/></mxCell><mxCell id="dcap" value="Còn chỗ (&amp;lt; 3) và&lt;br&gt;không trùng lịch?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=1.3;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="415.81" y="829" width="148.38" height="70" as="geometry"/></mxCell><mxCell id="full" value="Báo «Khung giờ vừa hết chỗ»&lt;br&gt;(409), chọn khung khác" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="836" width="240" height="56" as="geometry"/></mxCell><mxCell id="hold" value="Tạo lịch HOLD: hạn 5 phút,&lt;br&gt;mã khám 12 ký tự; ghi AUDIT_LOGS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="360" y="940" width="260" height="56" as="geometry"/></mxCell><mxCell id="fork" value="" style="html=1;fillColor=#000000;strokeColor=#000000;rounded=0;" vertex="1" parent="1"><mxGeometry x="340" y="1068" width="300" height="8" as="geometry"/></mxCell><mxCell id="pay" value="Quét VietQR, chuyển khoản cọc&lt;br&gt;(nội dung = mã khám)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="55" y="1148" width="250" height="56" as="geometry"/></mxCell><mxCell id="bank" value="Gửi webhook SePay&lt;br&gt;(kèm Apikey)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="685" y="1148" width="200" height="56" as="geometry"/></mxCell><mxCell id="job" value="Nếu quá 5 phút chưa nhận cọc:&lt;br&gt;HOLD → EXPIRED (SYSTEM),&lt;br&gt;trả chỗ cho người khác" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#ccfbf1;strokeColor=#0d9488;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="935" y="1140" width="230" height="72" as="geometry"/></mxCell><mxCell id="endj" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1035" y="1265" width="30" height="30" as="geometry"/></mxCell><mxCell id="recv" value="Ghi payment (gateway_txn_id UNIQUE);&lt;br&gt;tìm mã khám trong nội dung" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="355" y="1252" width="270" height="56" as="geometry"/></mxCell><mxCell id="ddup" value="Trùng&lt;br&gt;gateway_txn_id?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=1.3;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="421.25" y="1349" width="137.51" height="70" as="geometry"/></mxCell><mxCell id="skip" value="Bỏ qua giao dịch,&lt;br&gt;trả 200 (duplicate)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="690" y="1356" width="190" height="56" as="geometry"/></mxCell><mxCell id="end3" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1035" y="1369" width="30" height="30" as="geometry"/></mxCell><mxCell id="dok" value="Đúng mã, đủ tiền cọc&lt;br&gt;và HOLD còn hạn?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=1.3;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="407.66" y="1453" width="164.68" height="70" as="geometry"/></mxCell><mxCell id="conf" value="HOLD → CONFIRMED; gửi email xác nhận&lt;br&gt;kèm QR check-in; báo realtime" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="340" y="1564" width="300" height="56" as="geometry"/></mxCell><mxCell id="late" value="Ngoại lệ: tiền về muộn còn chỗ →&lt;br&gt;khôi phục CONFIRMED; hết chỗ →&lt;br&gt;REFUND_PENDING; sai tiền →&lt;br&gt;AMOUNT_MISMATCH; không có mã →&lt;br&gt;UNMATCHED (quản trị viên hoàn tiền)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=28;fontSize=12;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=1.3;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="660" y="1436" width="250" height="104" as="geometry"/></mxCell><mxCell id="end4" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="475" y="1681" width="30" height="30" as="geometry"/></mxCell><mxCell id="end5" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="770" y="1577" width="30" height="30" as="geometry"/></mxCell><mxCell id="zz8" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=7;strokeColor=#334155;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ff